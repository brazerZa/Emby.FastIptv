<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <!-- Which Emby install to compile against. Override with:
       dotnet build -p:EmbySystemDir="<path to Emby-Server\system>"
       Defaults to the per-user install, because that is the one that actually loads the
       plugin on a normal Windows setup; a Program Files install is often an older leftover
       and building against the wrong version is silent until the plugin fails to load. -->
  <PropertyGroup>
    <EmbySystemDir Condition="'$(EmbySystemDir)' == '' And Exists('$(APPDATA)\Emby-Server\system\MediaBrowser.Controller.dll')">$(APPDATA)\Emby-Server\system</EmbySystemDir>
    <EmbySystemDir Condition="'$(EmbySystemDir)' == ''">$(ProgramFiles)\Emby-Server\system</EmbySystemDir>
  </PropertyGroup>

  <Target Name="ReportEmbySystemDir" BeforeTargets="ResolveAssemblyReferences">
    <Message Importance="high" Text="Emby reference assemblies: $(EmbySystemDir)" />
    <Error Condition="!Exists('$(EmbySystemDir)\MediaBrowser.Controller.dll')"
           Text="No Emby assemblies at '$(EmbySystemDir)'. Pass -p:EmbySystemDir=&lt;path&gt;." />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(EmbySystemDir)\MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(EmbySystemDir)\MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(EmbySystemDir)\MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Thumb.png" />
    <EmbeddedResource Include="Configuration\configurationpage.html" />
    <EmbeddedResource Include="Configuration\configurationcontroller.js" />
    <EmbeddedResource Include="Configuration\tunersetup.html" />
    <EmbeddedResource Include="Configuration\tunersetupcontroller.js" />
  </ItemGroup>
</Project>
